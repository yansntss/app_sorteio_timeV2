              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"NAOEXISTE\",\n  \"votes\": [{ \"playerId\": \"1\", \"score\": 3 }]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/votes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "votes"]
            }
          }
        }
      ]
    }
  ]
}
